{
  "manifest_version": 3,
  "name": "KKday A/B Test Extension",
  "description": "觀測與切換 KKday A/B Test 狀態",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "KKday A/B Test"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kkday.com/*",
        "*://*.sit.kkday.com/*",
        "*://*.stage.kkday.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.kkday.com/*",
    "*://*.sit.kkday.com/*",
    "*://*.stage.kkday.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/page-script.js"],
      "matches": [
        "*://*.kkday.com/*",
        "*://*.sit.kkday.com/*",
        "*://*.stage.kkday.com/*"
      ]
    }
  ]
}
